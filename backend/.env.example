# ============================================================================
# SafeRide backend — environment variable template
# ----------------------------------------------------------------------------
# Copy to ".env" and fill in real values:   cp .env.example .env
# run.sh sources .env before launching the application with
# ./mvnw spring-boot:run. NEVER commit a real .env (see .gitignore).
# Every value here is also the default baked into application.yaml via
# ${VAR:default}, so only secrets strictly need to be set.
# ============================================================================

# ---- Server ---------------------------------------------------------------
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080

# ---- Database (PostgreSQL 16, single saferide_db) -------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saferide_db
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_PARAMS=
DB_POOL_SIZE=10
DB_MIN_IDLE=2
JPA_DDL_AUTO=update

# ---- JWT ------------------------------------------------------------------
# Base64 HS256 secret; generate your own and keep it out of version control.
JWT_SECRET=change-me-base64-secret
JWT_EXPIRATION=86400000

# ---- Mail (Brevo HTTP API by default; SMTP as fallback) -------------------
MAIL_PROVIDER=brevo
BREVO_API_KEY=change-me
BREVO_BASE_URL=https://api.brevo.com
# SMTP fallback (used when MAIL_PROVIDER=smtp)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=SafeRide

# ---- Email link bases (can point at a tunnel host for phone testing) ------
APP_VERIFICATION_BASE_URL=http://localhost:8080/api/v1/auth
APP_RESET_BASE_URL=http://localhost:8080
VERIFICATION_TOKEN_EXPIRY_HOURS=24
RESET_TOKEN_EXPIRY_HOURS=1

# ---- Fare pricing overrides (PKR) -----------------------------------------
PRICE_BASE_FARE=50
PRICE_PER_KM=20
PRICE_PER_MIN=2
PRICE_MIN_FARE=80
PRICE_PREMIUM_MULTIPLIER=1.5
PRICE_SEAT_SURCHARGE=0.15
PRICE_CURRENCY=PKR

# ---- Geoapify (routing for fare stamping) ---------------------------------
GEOAPIFY_KEY=change-me
GEOAPIFY_ROUTING_URL=https://api.geoapify.com/v1/routing

# ---- Didit identity verification ------------------------------------------
# The API key and workflow id are environment-paired: swap them together.
DIDIT_API_KEY=change-me
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_WORKFLOW_ID=change-me
# false for the sandbox; set true for production decisions.
DIDIT_ENFORCE_DOCUMENT_MATCH=false
