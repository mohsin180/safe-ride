# ============================================================================
# SafeRide — environment variables for all backend services
# ----------------------------------------------------------------------------
# Every value below is also the DEFAULT baked into the YAML config (via
# ${VAR:default}), so the stack runs without setting anything. Override here
# for your machine / staging / prod.
#
# Spring Boot does NOT read .env files automatically. To load these:
#   PowerShell:  . .\load-env.ps1   (sources this file into the current shell)
#   Then run any service from that same shell, e.g.:
#       cd user-services ; .\mvnw.cmd spring-boot:run
#   Or set them in your IDE run configuration's "Environment variables".
#
# Usage: copy to ".env" and edit.  ->  cp .env.example .env
# NEVER commit a real .env (see backend/.gitignore). Rotate the secrets below
# before any non-local deployment.
# ============================================================================

# ---- Config server -------------------------------------------------------
# URL the client services use to import config (used in each service's
# spring.config.import). Port the config-server itself binds to.
CONFIG_SERVER_URL=http://localhost:8888
CONFIG_SERVER_PORT=8888

# ---- PostgreSQL (shared host/credentials, one DB per service) ------------
# LOCAL defaults shown. For a cloud Postgres like Neon, set DB_HOST to the
# instance host, DB_USERNAME/DB_PASSWORD to the role creds, and DB_PARAMS to
# "?sslmode=require" (Neon mandates SSL). One host serves all DB_NAMEs below.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=kgf
# Appended verbatim to every JDBC URL. Empty for local; "?sslmode=require" for Neon.
DB_PARAMS=
# Per-service Hikari pool. 5 services × DB_POOL_SIZE connections total — keep the
# product under your Postgres connection cap (Neon free ≈ 100).
DB_POOL_SIZE=5
DB_MIN_IDLE=1

USER_DB_NAME=user_db
PROFILE_DB_NAME=profile_db
RIDES_DB_NAME=ride_db
NOTIFICATION_DB_NAME=notification_db
MESSAGING_DB_NAME=messaging_db

# Hibernate schema management: validate | update | create | create-drop
JPA_DDL_AUTO=update

# ---- Service ports -------------------------------------------------------
USER_SERVER_PORT=8001
PROFILE_SERVER_PORT=8002
RIDES_SERVER_PORT=8003
NOTIFICATION_SERVER_PORT=8004
MESSAGING_SERVER_PORT=8005
GATEWAY_SERVER_PORT=8080
GATEWAY_ADDRESS=0.0.0.0

# ---- RabbitMQ (rides-service + notification-service) ---------------------
# LOCAL broker defaults shown below. For CloudAMQP, read these off the
# instance page ("AMQP details") and note:
#   - HOST     = the "Server"/"Host" (e.g. cow.rmq2.cloudamqp.com)
#   - PORT     = 5671  (TLS)  ->  set RABBITMQ_SSL=true
#   - USERNAME = the "User & Vhost" value (a random id)
#   - VHOST    = SAME as the username (NOT "/")
#   - PASSWORD = the long token
# i.e. given amqps://abcdwxyz:LongPass@cow.rmq2.cloudamqp.com/abcdwxyz :
#   RABBITMQ_HOST=cow.rmq2.cloudamqp.com
#   RABBITMQ_PORT=5671
#   RABBITMQ_USERNAME=abcdwxyz
#   RABBITMQ_VHOST=abcdwxyz
#   RABBITMQ_PASSWORD=LongPass
#   RABBITMQ_SSL=true
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_SSL=false

# ---- JWT (must be IDENTICAL for user-services and api-gateway) ------------
# Base64-encoded HS256 key. Tokens are signed by user-services and validated
# at the gateway, so both read the same JWT_SECRET. CHANGE for production.
JWT_SECRET=U2FmZVJpZGVTZWNyZXRLZXlGb3JKV1RUb2tlbkdlbmVyYXRpb24yMDI2U3ByaW5nQm9vdA==
JWT_EXPIRATION=86400000

# ---- Mail / SMTP (user-services — email verification & password reset) ---
# Gmail app password. ROTATE this and move it out of the YAML default.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=mughallmohsin938@gmail.com
MAIL_PASSWORD=urplbyykuhehsjsw

# ---- App links in verification / reset emails (user-services) ------------
# APP_VERIFICATION_BASE_URL -> the gateway's /api/v1/auth.
# APP_RESET_BASE_URL        -> the FRONTEND origin (where the Flutter web
#                              build is served), NOT the gateway.
APP_VERIFICATION_BASE_URL=http://192.168.0.104:8080/api/v1/auth
APP_RESET_BASE_URL=http://192.168.0.104:8080
VERIFICATION_TOKEN_EXPIRY_HOURS=24
RESET_TOKEN_EXPIRY_HOURS=1

# ---- Service-to-service base URLs ----------------------------------------
# Used by rides-service / messaging-service (RestClient/Feign) AND by the
# api-gateway routes (GatewayConfig.java). USER/NOTIFICATION/MESSAGING are
# gateway-only.
USER_SERVICE_URL=http://localhost:8001
PROFILE_SERVICE_URL=http://localhost:8002
RIDES_SERVICE_URL=http://localhost:8003
NOTIFICATION_SERVICE_URL=http://localhost:8004
MESSAGING_SERVICE_URL=http://localhost:8005

# ---- Pricing / routing (rides-service) -----------------------------------
# Server-authoritative fare model. Each value is also the YAML default.
#   gross = max(MIN_FARE, (BASE_FARE + km*PER_KM + min*PER_MIN) * premiumMult)
#   per-seat = (gross - (seats>1 ? gross*SHARED_DISCOUNT : 0)) / seats
PRICE_BASE_FARE=50
PRICE_PER_KM=20
PRICE_PER_MIN=2
PRICE_SHARED_DISCOUNT=0.20
PRICE_PREMIUM_MULTIPLIER=1.5
PRICE_MIN_FARE=80
PRICE_CURRENCY=PKR
# Geoapify routing for road distance/time. Leave GEOAPIFY_KEY empty to fall
# back to Haversine (the app still runs without a key, just less accurate).
GEOAPIFY_KEY=
GEOAPIFY_ROUTING_URL=https://api.geoapify.com/v1/routing
